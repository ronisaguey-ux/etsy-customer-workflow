# Copy to keys.env and fill in. Never commit keys.env.
#   cp config/keys.env.example config/keys.env && chmod 600 config/keys.env
#
# Only DEEPSEEK is required. The free routers are fallbacks: the kit walks down the chain
# automatically when a model is unavailable or a free model is rate-limited.
#
# These names are the ones the kit reads. `lib/env.js` parses this file, `scripts/health-check.js`
# tests them
# and `scripts/analytics-digest.js` uses them. Renaming a key here without changing the script
# silently disables that feature, so if you edit a name, grep the scripts for it.

# --- required (paid) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ORCHESTRATOR_MODEL=deepseek-flash

# --- free, collect all three ---
ORCAROUTER_API_KEY=          # https://orcarouter.ai  (GitHub login, no card) sk-orca-...
OPENROUTER_API_KEY=          # https://openrouter.ai
DAHL_API_KEY=                # as supplied

# --- shop: Shopify (works immediately, no approval queue) ---
SHOPIFY_SHOP=                # the domain only, e.g. your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=        # Shopify admin -> Apps -> develop apps -> custom app -> Admin API token
SHOPIFY_API_VERSION=2025-10

# --- shop: Etsy (once the shop is approved) ---
ETSY_KEYSTRING=              # the app keystring from your Etsy app
ETSY_ACCESS_TOKEN=           # OAuth access token (scope transactions_r)
ETSY_SHOP_ID=                # your numeric shop id

# --- support inbox ---
SUPPORT_IMAP_HOST=
SUPPORT_IMAP_USER=
SUPPORT_IMAP_PASS=

# --- meta ads (when you start advertising) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=          # the number only; act_ is added for you
META_API_VERSION=v25.0

# --- telegram (optional) ---
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=            # your chat id; the agent pushes here

# --- Roblox (Open Cloud; see skills/roblox-open-cloud/SKILL.md for the scopes) ---
ROBLOX_API_KEY=              # Creator Hub -> Credentials
ROBLOX_UNIVERSE_ID=          # the experience id
ROBLOX_PLACE_ID=             # the start place id

# --- dispute guard: carrier tracking (optional) ---
# A generic provider URL. {num} and {carrier} are substituted. Without it, pass the status inline
# to dispute_guard. USPS TrackV2 also works with USPS_USERID (needs a granted tracking permission).
SHOPTOOLS_TRACKING_URL=
SHOPTOOLS_TRACKING_KEY=
USPS_USERID=

# --- Claude subagents (no key needed) ---
# The kit calls Claude Code as a deep-reasoning subagent, using your Claude subscription — there is
# no API key. Log in once by running `claude`. Only set this if the binary is somewhere unusual:
CLAUDE_BIN=
# Antigravity, if you use it (optional):
AGY_BIN=
