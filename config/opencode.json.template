{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["rules.md", "AGENTS.md"],

  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": { "baseURL": "{env:DEEPSEEK_BASE_URL}" },
      "models": { "deepseek-flash": { "name": "DeepSeek Flash" } }
    },
    "orcarouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OrcaRouter (free)",
      "options": { "baseURL": "https://api.orcarouter.ai/v1" },
      "models": { "orcarouter/free": { "name": "OrcaRouter Free (difficulty-routed)" } }
    }
  },
  "model": "deepseek/deepseek-flash",

  "mcp": {
    "shop-tools": {
      "type": "local",
      "command": ["node", "__KIT_DIR__/mcp/shop-tools/server.js"],
      "enabled": true
    },
    "roblox-open-cloud": {
      "type": "local",
      "command": ["node", "__KIT_DIR__/mcp/roblox-open-cloud/server.js"],
      "enabled": true
    },
    "commit-condom": {
      "type": "local",
      "command": ["node", "__KIT_DIR__/mcp/commit-condom/mcp/server.js"],
      "enabled": true
    },
    "compactor": {
      "type": "local",
      "command": ["node", "__KIT_DIR__/mcp/tool-call-compactor/bin/tcc.js", "serve", "--config", "__KIT_DIR__/config"],
      "enabled": true
    },
    "roblox-studio": {
      "type": "local",
      "command": ["npx", "-y", "@chrrxs/robloxstudio-mcp@latest", "--auto-install-plugin"],
      "enabled": false
    }
  },

  "agent": {
    "build": { "disable": true },
    "plan":  { "disable": true }
  }
}
